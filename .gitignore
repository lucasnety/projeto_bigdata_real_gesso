# --- OpenTofu / Terraform (Checkpoint 01 - DevOps) ---
infraestrutura/.terraform/
infraestrutura/terraform.tfstate
infraestrutura/terraform.tfstate.backup
infraestrutura/*.tfplan
infraestrutura/terraform.tfvars
infraestrutura/crash.log
dados/raw
# Lotes grandes (ex.: 100.000 serviços) são gerados na hora, não versionados
dados/raw_*
dados/tratado_*
# Modelos de ML treinados (gerados por scripts/modelos_ml.py)
dados/modelos/

# --- SSH / segredos ---
*.pem
*.key
id_rsa*
id_ed25519*
!*.pub
# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Segredos locais (use .env.example como modelo) ---
.env
