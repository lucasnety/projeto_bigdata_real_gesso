# Copie este arquivo para ".env" antes de subir o ambiente:
#   cp .env.example .env
#
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).
# Estes valores são apenas para ambiente LOCAL de desenvolvimento/estudo.

POSTGRES_DB=gesso_drywall
POSTGRES_USER=gesso_user
POSTGRES_PASSWORD=gesso_pass
POSTGRES_PORT=5432

# Porta de acesso ao Adminer (interface web para visualizar o banco)
ADMINER_PORT=8080

# String de conexão usada pelos scripts Python (carregar_dados.py etc.)
DATABASE_URL=postgresql://gesso_user:gesso_pass@localhost:5432/gesso_drywall
